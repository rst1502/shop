# =============================================================================
# Backend Application Properties
# Domain: srv1341707.hstgr.cloud
# =============================================================================

# --- Server ---
SERVER_HOST=srv1341707.hstgr.cloud
SERVER_PORT=9090
SERVER_BASE_URL=https://srv1341707.hstgr.cloud/api

# --- Database (PostgreSQL) ---
# Connect via the Nginx stream proxy using the db. subdomain
DB_HOST=db.srv1341707.hstgr.cloud
DB_PORT=443
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=true

# Direct internal connection (use this when the app is on the same host as Nginx)
DB_INTERNAL_HOST=127.0.0.1
DB_INTERNAL_PORT=5432

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://srv1341707.hstgr.cloud,https://srv1341707.hstgr.cloud/admin

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-strong-secret
JWT_EXPIRY=3600

# --- Storefront URL ---
STOREFRONT_URL=https://srv1341707.hstgr.cloud

# --- Admin URL ---
ADMIN_URL=https://srv1341707.hstgr.cloud/admin

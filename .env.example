# ═══════════════════════════════════════════════
#  ZimShop — Environment Variables
#  1. cp .env.example .env
#  2. Fill in your keys
#  3. docker-compose up --build
# ═══════════════════════════════════════════════

POSTGRES_DB=zimshop
POSTGRES_USER=zimshop
POSTGRES_PASSWORD=change_me_in_production

JWT_SECRET=change_this_to_a_random_256_bit_secret_key_at_least_32_chars

# Paynow Zimbabwe — https://www.paynow.co.zw
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_ENV=sandbox
PAYNOW_RETURN_URL=http://localhost:4201/checkout/return
PAYNOW_RESULT_URL=http://localhost:8080/api/v1/payments/paynow/callback

# Facebook — https://developers.facebook.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_CATALOG_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=zimshop-fb-token-change-me

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=zimshop-wa-token-change-me
